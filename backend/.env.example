# 局域网开发时，后端使用：uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
# 如需跨域直连后端，可将 FRONTEND_ORIGIN 临时改为 Frontend 的局域网访问地址。
DATABASE_URL=mysql+pymysql://YOUR_USERNAME:YOUR_PASSWORD@localhost:3306/luckywallet_dev
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
