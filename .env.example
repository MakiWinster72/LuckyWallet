# Docker Compose 局域网部署配置
# 启动后访问宿主机局域网 IP，例如：http://192.168.1.20/
# 不需要把下面的端口改成局域网 IP；Docker 会监听宿主机的 80 端口。

DB_NAME=luckywallet_dev
DB_USER=luckywallet
DB_PASSWORD=please-change-this-password
DB_ROOT_PASSWORD=please-change-root-password
JWT_SECRET=please-change-to-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 通过前端同源代理访问 API，通常保持 localhost 即可。
FRONTEND_ORIGIN=http://localhost
